job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "postgres" {
    network {
      mode = "bridge"

      port "postgres" {
        static       = ${port}
        to           = 5432
        host_network = "${internal_network}"
      }
%{ if mesh.enabled ~}

      # Envoy's metrics, scraped by the platform's Alloy for Consul's topology.
      port "envoy_metrics" {
        to           = 9102
        host_network = "${internal_network}"
      }
%{ endif ~}
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "postgres"
      provider = "consul"
%{ if mesh.enabled ~}

      # In the mesh: an Envoy sidecar takes the traffic (transparent proxy), so
      # mesh services reach PostgreSQL as ${job_name}.virtual.consul, over mTLS,
      # as the intentions allow. The ports kept open (and Envoy's metrics) are
      # still reached directly.
      connect {
        sidecar_service {
          proxy {
            transparent_proxy {
              # Envoy runs as uid 1337, which no app uses: the transparent proxy
              # lets Envoy's own uid out unredirected, so an app sharing it (Odoo
              # runs as 101, Envoy's default) would bypass the mesh.
              uid                   = "1337"
              no_dns                = true
              exclude_inbound_ports = ${jsonencode(concat([for p in mesh.keep_open_ports : tostring(p)], ["9102"]))}
            }
            config {
              envoy_prometheus_bind_addr = "0.0.0.0:9102"
            }
          }
        }

        sidecar_task {
          env {
            ENVOY_UID = "1337"
          }

          resources {
            cpu        = 50
            memory     = 32
            memory_max = 128
          }
        }
      }
%{ endif ~}

%{ if mesh.enabled ~}
      # Nomad takes no tcp check on a service in the mesh: PostgreSQL is asked
      # from inside its own container instead.
      check {
        type     = "script"
        task     = "postgres"
        command  = "pg_isready"
        args     = ["-h", "127.0.0.1", "-p", "5432", "-U", "${admin_user}"]
        interval = "15s"
        timeout  = "5s"
      }
%{ else ~}
      check {
        type     = "tcp"
        interval = "15s"
        timeout  = "5s"
      }
%{ endif ~}
    }
%{ if mesh.enabled ~}

    service {
      name     = "${job_name}-envoy"
      port     = "envoy_metrics"
      provider = "consul"
      tags     = ["metrics"]
    }
%{ endif ~}

    task "postgres" {
      driver = "docker"
      user   = "999:999"

      config {
        image    = "${image}"
        cap_drop = ["all"]

        mount {
          type   = "tmpfs"
          target = "/tmp"
          tmpfs_options { size = 134217728 }
        }

        mount {
          type   = "tmpfs"
          target = "/run/postgresql"
          tmpfs_options { size = 33554432 }
        }
      }

      volume_mount {
        volume      = "data"
        destination = "/var/lib/postgresql/data"
      }

      vault {}

      env {
        POSTGRES_USER = "${admin_user}"
        POSTGRES_DB   = "${admin_user}"
        PGDATA        = "/var/lib/postgresql/data/pgdata"
      }

      template {
        destination = "secrets/postgres.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}POSTGRES_PASSWORD={{ .Data.data.password }}{{ end }}
        EOT
      }

      resources {
        cpu        = ${resources.cpu}
        memory     = ${resources.memory}
        memory_max = ${resources.memory_max}
      }
    }
  }
}
