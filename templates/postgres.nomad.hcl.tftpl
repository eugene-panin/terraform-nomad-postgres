job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "postgres" {
    network {
      mode = "bridge"

      port "postgres" {
        static       = ${port}
        to           = 5432
        host_network = "${internal_network}"
      }
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "postgres"
      provider = "consul"

      check {
        type     = "tcp"
        interval = "15s"
        timeout  = "5s"
      }
    }

    task "postgres" {
      driver = "docker"
      user   = "999:999"

      config {
        image    = "${image}"
        cap_drop = ["all"]

        mount {
          type   = "tmpfs"
          target = "/tmp"
          tmpfs_options { size = 134217728 }
        }

        mount {
          type   = "tmpfs"
          target = "/run/postgresql"
          tmpfs_options { size = 33554432 }
        }
      }

      volume_mount {
        volume      = "data"
        destination = "/var/lib/postgresql/data"
      }

      vault {}

      env {
        POSTGRES_USER = "${admin_user}"
        POSTGRES_DB   = "${admin_user}"
        PGDATA        = "/var/lib/postgresql/data/pgdata"
      }

      template {
        destination = "secrets/postgres.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}POSTGRES_PASSWORD={{ .Data.data.password }}{{ end }}
        EOT
      }

      resources {
        cpu    = ${resources.cpu}
        memory = ${resources.memory}
      }
    }
  }
}
